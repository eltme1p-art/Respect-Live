# ═══════════════════════════════════════════════════════════
#  Respect Live — Environment Variables
#  انسخ هذا الملف إلى .env وعدّل القيم
#  ⚠️ لا مسافات حول = ولا quotes حول القيم
# ═══════════════════════════════════════════════════════════

# ─── الحساب الإداري (مطلوب) ───────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_to_strong_password

# ─── سرّ الجلسات (مطلوب — 64 حرف hex) ────────────────────
# لتوليد واحد جديد: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=put_your_random_64_hex_here

# ─── اسم الموقع (اختياري) ─────────────────────────────────
SITE_NAME=Respect Live

# ─── مسار قاعدة البيانات ─────────────────────────────────
# محلياً: respect.db
# على Railway مع Volume: /app/data/respect.db
DB_PATH=respect.db

# ─── بورت السيرفر (اختياري — افتراضي 8000) ───────────────
PORT=8000

# ═══════════════════════════════════════════════════════════
#  Discord Bot / Self-Bot
#  ⚠️ Self-bot يتطلب: pip install discord.py-self
#  ⚠️ Self-bot مخالف لشروط ديسكورد — الحساب معرّض للحظر
# ═══════════════════════════════════════════════════════════

# التوكن (شخصي أو بوت رسمي)
DISCORD_BOT_TOKEN=MTM5MDA5NzMzMDg3MDY4NTcxNg.GdYlex.u5YHtL-P4djPWxyRUvtwbZvbI_xdnwDYWUvJsI

# 🆕 تشغيل/إيقاف الديسكورد كلياً
# 1 = مفعّل (افتراضي)  |  0 = معطّل تماماً
DISCORD_ENABLE=1

# 🆕 تفعيل وضع self-bot (توكن شخصي)
# 1 = يستخدم توكنك الشخصي (افتراضي)  |  0 = بوت رسمي فقط
SELF_BOT_MODE=1

# 🆕 إذا فشل self-bot (مكتبة غير مثبتة) يرجع لـ bot عادي
# 1 = نعم (افتراضي)  |  0 = يوقف البوت عند الفشل
DISCORD_FALLBACK_BOT=1

# الرومات المراقبة — IDs رقمية مفصولة بفواصل
# اتركها فارغة = يكتشف كل الرومات تلقائياً (auto discovery)
# مثال: 112233445566778899,998877665544332211
DISCORD_WATCH_CHANNELS=

# السيرفرات المسموحة — IDs رقمية مفصولة بفواصل
# اتركها فارغة = يقبل أي سيرفر
# ⚠️ مع self-bot: عادة اتركها فاضية
DISCORD_ALLOWED_GUILDS=

# ═══════════════════════════════════════════════════════════
#  Telegram Bot (اختياري — لإرسال الإشعارات)
#  أنشئ بوت من @BotFather واحصل على التوكن
# ═══════════════════════════════════════════════════════════
TELEGRAM_TOKEN=

# ═══════════════════════════════════════════════════════════
#  Groq AI (اختياري — لإعادة صياغة الرسائل)
#  احصل على مفتاح مجاني من: https://console.groq.com/keys
#  يبدأ بـ gsk_
#  يمكن تركه فارغاً وإدخاله من لوحة التحكم
# ═══════════════════════════════════════════════════════════
GROQ_API_KEY=

# ═══════════════════════════════════════════════════════════
#  Web Push Notifications (اختياري — إشعارات المتصفح)
#  لتوليد المفاتيح:
#  pip install py-vapid
#  vapid --gen
# ═══════════════════════════════════════════════════════════
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com
