# ═══════════════════════════════════════════════════════════
#  Respect Live — Environment Variables
#  انسخ هذا الملف إلى .env وعدّل القيم
# ═══════════════════════════════════════════════════════════

# ─── الحساب الإداري (مطلوب) ───────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_to_strong_password

# ─── سرّ الجلسات (مطلوب — 64 حرف عشوائي) ─────────────────
# لتوليد واحد جديد شغّل: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=put_your_random_64_hex_here

# ─── اسم الموقع (اختياري) ─────────────────────────────────
SITE_NAME=Respect Live

# ─── مسار قاعدة البيانات (مطلوب على Railway) ─────────────
# محلياً: respect.db
# على Railway مع Volume: /app/data/respect.db
DB_PATH=respect.db

# ═══════════════════════════════════════════════════════════
#  Discord Bot (مطلوب لتشغيل البوت)
# ═══════════════════════════════════════════════════════════
DISCORD_BOT_TOKEN=

# الرومات المراقبة — IDs رقمية مفصولة بفواصل
# مثال: 112233445566778899,998877665544332211
DISCORD_WATCH_CHANNELS=

# السيرفرات المسموحة (يُنصح بها للبوت العام) — IDs رقمية مفصولة بفواصل
# اتركها فارغة ليقبل أي سيرفر (خطر إذا البوت عام)
DISCORD_ALLOWED_GUILDS=

# ═══════════════════════════════════════════════════════════
#  Telegram (اختياري — للمستقبل)
# ═══════════════════════════════════════════════════════════
TELEGRAM_TOKEN=
