# ═══════════════════════════════════════════════════════════
#  Respect Live — Environment Variables
# ═══════════════════════════════════════════════════════════

# ─── الحساب الإداري (مطلوب) ───
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme_now

# ─── سر الجلسات (64 حرف hex) ───
SESSION_SECRET=put_your_random_64_hex_here

# ─── الموقع ───
SITE_NAME=Respect Live
DB_PATH=respect.db
PORT=8000

# ═══════════════════════════════════════════════════════════
#  Discord — يشتغل بالوضعين معاً
# ═══════════════════════════════════════════════════════════

# التوكن (سواء شخصي User Token أو بوت رسمي Bot Token)
DISCORD_BOT_TOKEN=

# 1 = self-bot (توكن شخصي) | 0 = بوت رسمي (Bot Token)
SELF_BOT_MODE=1

# 1 = إذا فشل self-bot يرجع لبوت عادي تلقائياً
DISCORD_FALLBACK_BOT=1

# 1 = تشغيل البوت | 0 = إيقافه
DISCORD_ENABLE=1

# رومات محددة (فارغة = كل الرومات)
DISCORD_WATCH_CHANNELS=

# سيرفرات مسموحة (فارغة = الكل)
DISCORD_ALLOWED_GUILDS=

# ─── Telegram ───
TELEGRAM_TOKEN=

# ─── Groq AI ───
GROQ_API_KEY=

# ─── Push ───
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com
